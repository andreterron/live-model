    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.17",
    "leva": "^0.10.1",
    "live-model": "workspace:*",
    "lucide-react": "^0.487.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.17.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.3"
