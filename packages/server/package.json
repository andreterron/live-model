{
  "name": "@live-model/server",
  "version": "0.4.6",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "live-model-server": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --build tsconfig.lib.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@live-model/api": "workspace:*",
    "crossws": "^0.4.6",
    "srvx": "^0.11.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vite-plugin-dts": "~5.0.2"
  }
}
