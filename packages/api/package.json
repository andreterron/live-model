{
  "name": "@live-model/api",
  "version": "0.4.6",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "live-model-api": "./dist/server.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest",
    "typecheck": "tsc --build tsconfig.lib.json"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@live-model/protocol": "workspace:*",
    "crossws": "^0.4.6",
    "srvx": "^0.11.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vite-plugin-dts": "~5.0.2",
    "vitest": "^4.1.8"
  }
}
